# Database Configuration Template
# Copy this file and update with your actual credentials

# Database Connection Settings
DB_HOST=127.0.0.1          # MySQL server host (localhost or IP)
DB_PORT=3306               # MySQL port (default 3306)
DB_NAME=diet_system        # Database name
DB_USER=root               # MySQL username
DB_PASS=                   # MySQL password (empty if none)

# Application Settings
APP_ENV=production         # development or production
APP_DEBUG=false            # Enable debug mode (true/false)
SESSION_LIFETIME=3600      # Session lifetime in seconds

# CORS Settings
CORS_ORIGIN=*              # Allowed origin domains
CORS_CREDENTIALS=true      # Allow credentials (true/false)

# Email Settings (for future use)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@dietsystem.com

# Application Base URL
APP_URL=http://localhost:8000
API_BASE_URL=/api

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Session Settings
SESSION_DRIVER=file        # file, database, memcached, redis
SESSION_LIFETIME=120       # minutes
REMEMBER_ME_LIFETIME=525600  # minutes (1 year)

# Security
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL=false

# Calorie Settings
DEFAULT_CALORIE_GOAL=2000
WARNING_THRESHOLD_PERCENT=10  # Percentage over limit to show warning
